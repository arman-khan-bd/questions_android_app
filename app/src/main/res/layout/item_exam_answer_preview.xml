<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/corner_radius_lg"
    app:cardElevation="@dimen/elevation_sm"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Question Index + Star -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPreviewQuestionNum"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/primary"
                android:textSize="14sp"
                tools:text="Question 1" />

            <TextView
                android:id="@+id/tvUserOutcomeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Correct (+1.00)" />

            <ImageView
                android:id="@+id/btnStarPreview"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Star"
                android:padding="4dp"
                app:srcCompat="@drawable/ic_star"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <!-- Question Text -->
        <TextView
            android:id="@+id/tvPreviewQuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            tools:text="Which Article of the Constitution of Bangladesh guarantees Freedom of Assembly?" />

        <ImageView
            android:id="@+id/ivPreviewQuestionImage"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="10dp"
            android:contentDescription="Question Image"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- Option A -->
        <LinearLayout
            android:id="@+id/layoutPreviewOptionA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_option_card"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPreviewLabelA"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_dialog_rounded"
                    android:backgroundTint="@color/surface_variant"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPreviewOptionA"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    tools:text="Article 37" />

                <TextView
                    android:id="@+id/tvPreviewPctA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    tools:text="74%" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbPreviewA"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:progress="74"
                android:progressTint="@color/primary" />
        </LinearLayout>

        <!-- Option B -->
        <LinearLayout
            android:id="@+id/layoutPreviewOptionB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_option_card"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPreviewLabelB"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_dialog_rounded"
                    android:backgroundTint="@color/surface_variant"
                    android:gravity="center"
                    android:text="B"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPreviewOptionB"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    tools:text="Article 38" />

                <TextView
                    android:id="@+id/tvPreviewPctB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    tools:text="15%" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbPreviewB"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:progress="15"
                android:progressTint="@color/primary" />
        </LinearLayout>

        <!-- Option C -->
        <LinearLayout
            android:id="@+id/layoutPreviewOptionC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_option_card"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPreviewLabelC"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_dialog_rounded"
                    android:backgroundTint="@color/surface_variant"
                    android:gravity="center"
                    android:text="C"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPreviewOptionC"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    tools:text="Article 39" />

                <TextView
                    android:id="@+id/tvPreviewPctC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    tools:text="8%" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbPreviewC"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:progress="8"
                android:progressTint="@color/primary" />
        </LinearLayout>

        <!-- Option D -->
        <LinearLayout
            android:id="@+id/layoutPreviewOptionD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_option_card"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPreviewLabelD"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_dialog_rounded"
                    android:backgroundTint="@color/surface_variant"
                    android:gravity="center"
                    android:text="D"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPreviewOptionD"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    tools:text="Article 40" />

                <TextView
                    android:id="@+id/tvPreviewPctD"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    tools:text="3%" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbPreviewD"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:progress="3"
                android:progressTint="@color/primary" />
        </LinearLayout>

        <!-- Full Explanation Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_dialog_rounded"
            android:backgroundTint="@color/surface_variant"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvPreviewCorrectKeyHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/success"
                android:textSize="13sp"
                tools:text="Correct Key: Option A" />

            <TextView
                android:id="@+id/tvPreviewExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                tools:text="Article 37 of the Constitution of the People's Republic of Bangladesh guarantees Freedom of Assembly subject to public order." />

            <ImageView
                android:id="@+id/ivPreviewExplanationImage"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:contentDescription="Explanation Diagram"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
