<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:backgroundTint="@color/surface"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header (Always Visible) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_dialog_rounded"
            android:backgroundTint="#FEE2E2"
            android:contentDescription="Report"
            android:padding="6dp"
            app:srcCompat="@drawable/ic_flag"
            app:tint="@color/error" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Report Question Dispute"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Flag errors for administrator inspection"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Body (Guarantees buttons always fit on screen) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:maxHeight="320dp"
        android:overScrollMode="never"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.05"
                android:text="SELECT ISSUE TYPE"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <!-- Reason Selector RadioGroup -->
            <RadioGroup
                android:id="@+id/rgReportReasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbWrongKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Wrong Answer Key"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbTypo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Typo / Grammatical Mistake"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbOutdated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Outdated / Changed Information"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbDuplicate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Duplicate Question"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbSpam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Spam / Irrelevant Content"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </RadioGroup>

            <!-- Additional Note -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:boxBackgroundColor="@color/surface_variant"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxStrokeColor="@color/primary"
                app:boxStrokeWidth="1dp"
                app:hintEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etReportNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="top|start"
                    android:hint="Explanation / Book Reference (Optional)"
                    android:inputType="textMultiLine"
                    android:lines="2"
                    android:maxLines="4"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Pinned Footer Buttons (Always Fully Visible) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelReport"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:text="@string/cancel"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitReport"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="@color/error"
            android:fontFamily="sans-serif-bold"
            android:text="Submit Report"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_flag"
            app:iconSize="16dp"
            app:iconTint="@color/text_white" />
    </LinearLayout>

</LinearLayout>
