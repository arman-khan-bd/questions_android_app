<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Streamlined Top Header Bar: Sort/Filter on Left, Search + Select All on Right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="8dp">

                <!-- Filter & Sort Trigger Button (Left) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnFilterAndSort"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/surface_variant"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:contentDescription="Filters"
                            app:srcCompat="@drawable/ic_filter"
                            app:tint="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="Sort / Filter"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <!-- Active Filter Counter Badge -->
                        <TextView
                            android:id="@+id/tvActiveFilterBadge"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="5dp"
                            android:background="@drawable/bg_dialog_rounded"
                            android:backgroundTint="@color/primary"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/text_white"
                            android:textSize="10sp"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Active Filter Tags (Scrollable Chips) -->
                <HorizontalScrollView
                    android:id="@+id/hsvActiveFilters"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cgActiveFilterChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipActiveDifficulty"
                            style="@style/Widget.MaterialComponents.Chip.Entry"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:text="Medium"
                            android:textSize="10sp"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipActiveSubject"
                            style="@style/Widget.MaterialComponents.Chip.Entry"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:text="Subject"
                            android:textSize="10sp"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipActiveSort"
                            style="@style/Widget.MaterialComponents.Chip.Entry"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:text="Popular"
                            android:textSize="10sp"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <!-- Search Toggle Icon Button (Right) -->
                <ImageView
                    android:id="@+id/btnToggleSearch"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Search Questions"
                    android:padding="7dp"
                    app:srcCompat="@drawable/ic_search"
                    app:tint="@color/text_primary" />

                <!-- Select All / Clear Selection Button (Right) -->
                <TextView
                    android:id="@+id/btnSelectAllToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="Select All"
                    android:textColor="@color/primary"
                    android:textSize="12sp" />

                <!-- Refresh Button -->
                <ImageView
                    android:id="@+id/btnRefreshQuestions"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Refresh Questions"
                    android:padding="7dp"
                    app:srcCompat="@drawable/ic_refresh"
                    app:tint="@color/text_muted" />
            </LinearLayout>

            <!-- Collapsible Search Input Box (Default Gone) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutSearchContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface_variant"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="Search"
                        app:srcCompat="@drawable/ic_search"
                        app:tint="@color/text_muted" />

                    <EditText
                        android:id="@+id/etQuestionSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="sans-serif"
                        android:hint="@string/search_questions_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/btnClearSearch"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Clear Search"
                        android:padding="3dp"
                        android:visibility="gone"
                        app:srcCompat="@drawable/ic_close"
                        app:tint="@color/text_muted" />

                    <ImageView
                        android:id="@+id/btnCloseSearch"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Close Search"
                        android:padding="3dp"
                        app:srcCompat="@drawable/ic_close"
                        app:tint="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main List & Pull To Refresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvQuestions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="120dp"
                tools:listitem="@layout/item_question_card" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:alpha="0.4"
                    android:contentDescription="Empty"
                    app:srcCompat="@drawable/ic_nav_questions"
                    app:tint="@color/text_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/no_questions_found"
                    android:textAlignment="center"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:text="Try adjusting your search terms, difficulty, or subject filters."
                    android:textAlignment="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnResetFilters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/primary"
                    android:text="Reset Filters"
                    android:textAllCaps="false"
                    android:textColor="@color/text_white" />
            </LinearLayout>

            <!-- Loading Spinner -->
            <ProgressBar
                android:id="@+id/pbInitialLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Pagination Progress Bar -->
            <ProgressBar
                android:id="@+id/pbPagination"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="90dp"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Conditionally Visible Floating Action Button: Create Self-Exam (Only visible when >= 1 questions selected) -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabCreateExamFromQuestions"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="72dp"
        android:contentDescription="Create Self-Exam"
        android:text="Exam (0)"
        android:textColor="@color/text_white"
        android:textSize="11sp"
        android:visibility="gone"
        tools:visibility="gone"
        app:backgroundTint="@color/accent"
        app:elevation="4dp"
        app:icon="@drawable/ic_trophy"
        app:iconSize="16dp"
        app:iconTint="@color/text_white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
