<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:backgroundTint="@color/surface"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_dialog_rounded"
        android:backgroundTint="@color/border" />

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="Filter &amp; Sort"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btnSheetReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="sans-serif-medium"
            android:padding="6dp"
            android:text="Reset All"
            android:textColor="@color/primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Difficulty Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.05"
        android:text="DIFFICULTY"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cgSheetDifficulty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:singleLine="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSheetDiffAll"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="All Levels"
            android:textSize="12sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSheetDiffEasy"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Easy"
            android:textColor="@color/diff_easy"
            android:textSize="12sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSheetDiffMedium"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medium"
            android:textColor="@color/diff_medium"
            android:textSize="12sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSheetDiffHard"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hard"
            android:textColor="@color/diff_hard"
            android:textSize="12sp" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Subject Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.05"
        android:text="SUBJECT"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgSheetSubjects"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSheetSubjectAll"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="All Subjects"
                android:textSize="12sp" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Sort By Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.05"
        android:text="SORT BY"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cgSheetSort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:singleLine="false"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSheetSortWeakTopics"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Weak Topics (Mistakes)"
            android:textSize="12sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSheetSortLatest"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Latest Questions"
            android:textSize="12sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSheetSortPopular"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Most Popular"
            android:textSize="12sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSheetSortAttempts"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Most Attempts"
            android:textSize="12sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSheetSortEasyFirst"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Easy First"
            android:textSize="12sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSheetSortHardFirst"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hard First"
            android:textSize="12sp" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Apply Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSheetApply"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/primary"
        android:fontFamily="sans-serif-bold"
        android:text="Apply Filters"
        android:textAllCaps="false"
        android:textColor="@color/text_white"
        android:textSize="14sp"
        app:cornerRadius="12dp" />

</LinearLayout>
